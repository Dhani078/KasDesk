# ── TiDB Cloud (MySQL-compatible) ────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.
DATABASE_HOST="your-tidb-host.tidbcloud.com"
DATABASE_PORT="4000"
DATABASE_USER="..."
DATABASE_PASSWORD="..."
DATABASE_NAME="kasdesk"

# ── Auth.js v5 ───────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="..."
# Must match the port the server actually runs on, or callbacks break.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional — Google sign-in. Leave blank to disable.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Gemini (receipt OCR) ─────────────────────────────
# Optional. /api/scan-receipt returns 503 OCR_NOT_CONFIGURED when unset.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
