{
  "id": "/",
  "name": "KASDESK \u2014 Keuangan Pribadi",
  "short_name": "KASDESK",
  "description": "Catat transaksi, kelola dompet, target, utang, dan laporan dalam satu aplikasi.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0D0D0F",
  "theme_color": "#0D0D0F",
  "orientation": "any",
  "lang": "id-ID",
  "dir": "ltr",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "receipt",
          "accept": ["image/jpeg", "image/png", "image/webp", "application/pdf"]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Catat Cepat (QuickLog)",
      "short_name": "Catat",
      "url": "/?action=quicklog",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Scan Struk AI",
      "short_name": "Scan Struk",
      "url": "/?action=scan",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Tanya AI Coach",
      "short_name": "AI Coach",
      "url": "/coach",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Dompet & Saldo",
      "short_name": "Dompet",
      "url": "/wallets",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Laporan Finansial",
      "short_name": "Laporan",
      "url": "/insights",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
